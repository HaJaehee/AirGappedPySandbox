# Dev-only virtualenv (server deps for local testing; not part of the deliverable)
.devvenv/

# Bundled binaries — too large for git, staged locally only for zipping
offline_wheels/
# Portable Python distributions (WinPython etc.) placed inside the dist package
WPy64-*/
WPy32-*/
dist/**/python/

# Zipped build outputs (the packaged distribution the user ships)
*.zip

# Claude Code personal/local settings (permissions allowlist)
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# Runtime I/O — keep the folder, ignore its contents
workspace/*
!workspace/.gitkeep
